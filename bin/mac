#!/bin/sh
# Runs `mac` under cli-graph's own uv venv (`uv sync`), the one the suite runs
# under, so a green suite speaks for the `mac` users run (task:d30c0330). It
# brings local-mac's dependencies, pyobjc for calendar's EventKit included,
# through the path dependency. MAC_PYTHON overrides it. Without the venv it
# falls back to python3 so _backend reports what is missing as JSON; it never
# falls back to local-mac's venv, whose versions the suite does not test.
here=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
py=${MAC_PYTHON:-$here/.venv/bin/python}
[ -x "$py" ] || py=python3
PYTHONPATH="$here${PYTHONPATH:+:$PYTHONPATH}" exec "$py" -m mac "$@"
